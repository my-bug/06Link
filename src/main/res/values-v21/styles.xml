<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TextAppearance.Compat.Notification" parent="@android:style/TextAppearance.Material.Notification" />
    <style name="TextAppearance.Compat.Notification.Info" parent="@android:style/TextAppearance.Material.Notification.Info" />
    <style name="TextAppearance.Compat.Notification.Time" parent="@android:style/TextAppearance.Material.Notification.Time" />
    <style name="TextAppearance.Compat.Notification.Title" parent="@android:style/TextAppearance.Material.Notification.Title" />
    <style name="Theme.Xcertplay" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">#0a0e1c</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:alertDialogTheme">@style/Theme.Xcertplay.Dialog</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#96c4ff</item>
        <item name="android:statusBarColor">#0a0e1c</item>
        <item name="android:navigationBarColor">#0a0e1c</item>
    </style>
    <style name="Theme.Xcertplay.Dialog" parent="@android:style/Theme.Material.Dialog.Alert">
        <item name="android:textColorPrimary">#ffffff</item>
        <item name="android:textColorSecondary">#a8b6ca</item>
        <item name="android:windowBackground">@drawable/dp_dialog_background</item>
        <item name="android:buttonBarButtonStyle">@style/Widget.Xcertplay.DialogButton</item>
        <item name="android:colorAccent">#96c4ff</item>
    </style>
    <style name="Theme.Xcertplay.Dialog.Light" parent="@android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:textColorPrimary">#1c1c1e</item>
        <item name="android:textColorSecondary">#636366</item>
        <item name="android:windowBackground">@drawable/dp_dialog_background_light</item>
        <item name="android:buttonBarButtonStyle">@style/Widget.Xcertplay.DialogButton.Light</item>
        <item name="android:colorAccent">#006adc</item>
    </style>
    <style name="Theme.Xcertplay.Light" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">#f2f2f7</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:alertDialogTheme">@style/Theme.Xcertplay.Dialog.Light</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#006adc</item>
        <item name="android:statusBarColor">#f2f2f7</item>
        <item name="android:navigationBarColor">#f2f2f7</item>
    </style>
    <style name="Widget.Compat.NotificationActionContainer" parent="">
        <item name="android:background">@drawable/notification_action_background</item>
    </style>
    <style name="Widget.Compat.NotificationActionText" parent="">
        <item name="android:textAppearance">?android:textAppearanceButton</item>
        <item name="android:textSize">@dimen/notification_action_text_size</item>
        <item name="android:textColor">@color/androidx_core_secondary_text_default_material_light</item>
    </style>
    <style name="Widget.Xcertplay.DialogButton" parent="@android:style/Widget.Material.Button.Borderless.Colored">
        <item name="android:textSize">17.0sp</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <style name="Widget.Xcertplay.DialogButton.Light" parent="@android:style/Widget.Material.Light.Button.Borderless.Colored">
        <item name="android:textSize">17.0sp</item>
        <item name="android:textAllCaps">false</item>
    </style>
</resources>
