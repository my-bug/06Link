# The main development directory is the repository. Keep local material local.
/*
!/.gitignore
!/.gitattributes
!/.editorconfig
!/.github/
!/AGENTS.md
!/README.md
!/CONTRIBUTING.md
!/SECURITY.md
!/LICENSE
!/NOTICE.md
!/project.json
!/settings.gradle
!/build.gradle
!/gradle.properties
!/gradlew
!/gradlew.bat
!/gradle/
!/src/
!/scripts/
!/tests/
!/tooling/
!/docs/

# Necessary engineering docs are versioned; old device/research reports stay local.
/docs/*
!/docs/BUILD.md
!/docs/PROJECT_STRUCTURE.md

# Public tool binaries are obtained from the locked official sources.
/tooling/*
!/tooling/manifest.json
!/tooling/compile-stubs/
!/tooling/java/

# Only test code and fixed fixtures, never results or device captures.
/tests/**
!/tests/**/
!/tests/**/*.py
!/tests/**/*.java
!/tests/source_build/contracts.json
!/tests/fixtures/**
/tests/vehicle/
/tests/**/build/
/tests/**/classes/

# Generated output and private credentials must never be committed.
.DS_Store
.idea/
.vscode/
.gradle/
.private/
.local/
__pycache__/
*.pyc
*.class
*.dex
*.apk
*.aab
*.apks
*.log
*.p12
*.pfx
*.jks
*.keystore
*.key
*.pem
*.pk8
*.p7b
local.properties
